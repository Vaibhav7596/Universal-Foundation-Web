# ─── Copy this file to .env for local development ───────────────
# NEVER commit the actual .env file to git.

# ── MongoDB Atlas ────────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com
# Connect > Drivers > Copy the connection string
# Replace <password> with your actual DB user password
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/universalfoundation?retryWrites=true&w=majority

# ── Cloudinary (image uploads) ───────────────────────────────────
# Get these from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Admin Credentials (optional — defaults shown below) ──────────
# If not set, defaults are: admin / UniversalNGO2026!
# Change IMMEDIATELY after first login via the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=UniversalNGO2026!

# ── Server ───────────────────────────────────────────────────────
PORT=3000
